# 1. find_duplicates
def find_duplicates(lst):
    seen = set()
    dupes = set()
    for item in lst:
        if item in seen:
            dupes.add(item)
        else:
            seen.add(item)
    return dupes

print(find_duplicates([1, 2, 2, 3, 3, 3, 4]))   # {2, 3}

